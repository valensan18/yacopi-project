# Copiar a .env y ajustar. NO commitear .env real.
APP_ENV=development
LOG_LEVEL=INFO

# Backend
DATABASE_URL=sqlite:///./data/parcels.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Inferencia EXPERIMENTAL del proxy (Ruta B). Desactivada por defecto.
# Solo habilitar en desarrollo local con el artefacto exp-proxy-001 presente.
EXPERIMENTAL_INFERENCE_ENABLED=false

# ML
MODEL_DIR=ml/artifacts
DATA_VERSION=

# Frontend (variables de build de Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
