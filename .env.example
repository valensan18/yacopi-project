# Copiar a .env y ajustar. NO commitear .env real.
APP_ENV=development
LOG_LEVEL=INFO

# Backend
DATABASE_URL=sqlite:///./data/parcels.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Producción (Docker): rutas dentro del contenedor backend
# DATABASE_PATH=/app/data/parcels.db
# MODEL_DIR=/app/model
# CORS_ORIGINS=https://tu-dominio

# Inferencia EXPERIMENTAL del proxy histórico (Ruta B). Desactivada por defecto.
EXPERIMENTAL_INFERENCE_ENABLED=false

# Demostración EXPERIMENTAL ZHG (Random Forest). Desactivada por defecto.
# Solo habilitar tras decisión explícita del equipo en el servidor.
EXPERIMENTAL_ZHG_ENABLED=false

# ML
MODEL_DIR=ml/artifacts
DATA_VERSION=

# Frontend (variables de build de Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
